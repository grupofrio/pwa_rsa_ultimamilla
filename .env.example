# Vía Ágil Control — variables de frontend (sin secretos)
# Copiar a .env.local para desarrollo. Nunca pongas tokens, contraseñas ni claves.

# URL pública del API de Sebastián. Vacío = el adaptador HTTP no envía llamadas.
VITE_API_BASE_URL=

# mock | http
# En `vite build` el adaptador mock NO entra al bundle, aunque esta variable diga mock.
# Solo el servidor de desarrollo y las pruebas pueden usar mock.
VITE_API_ADAPTER=mock

# development | staging | production
VITE_APP_ENV=development

# Zona operativa por defecto del scope activo (IANA). El backend debe enviarla por scope.
VITE_DEFAULT_TIMEZONE=America/Mexico_City

# Moneda de presentación. Los importes oficiales los entrega el backend.
VITE_DEFAULT_CURRENCY=MXN
